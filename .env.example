# Ghost Net Detection Backend - Environment Configuration Example
PROJECT_NAME="Ghost Net Detection Backend (SSS)"
API_V1_PREFIX="/api"
DEBUG=True

# Detector Backend: 'mock', 'teammate', or 'dual_yolo'
DETECTOR_BACKEND=dual_yolo
TEAMMATE_MODEL_PATH=weights/teammate_model.onnx
TEAMMATE_DEVICE=cpu

# Dual YOLO Model Checkpoint Paths
DUAL_YOLO_MODEL_A=weights/model_a.pt
DUAL_YOLO_MODEL_B=weights/model_b.pt
DUAL_YOLO_CONFIDENCE=0.25

# Evidence Fusion Engineering Prior Weights (Sum to ~1.0)
WEIGHT_ANOMALY=0.30
WEIGHT_SHAPE=0.20
WEIGHT_TEXTURE=0.20
WEIGHT_SHADOW=0.15
WEIGHT_SIZE=0.05
WEIGHT_CONTEXT=0.10

# Priority Classification Thresholds
PRIORITY_HIGH_THRESHOLD=0.70
PRIORITY_MEDIUM_THRESHOLD=0.40

# Sonar Acoustic Shadow Configuration
# Options: 'metadata_based', 'away_from_nadir', 'port', 'starboard', 'adaptive'
SHADOW_DIRECTION_MODE=metadata_based
SHADOW_PERCENTILE_CUTOFF=15.0
SHADOW_SIGMA_FACTOR=1.5
SHADOW_ABSOLUTE_MAX_INTENSITY=35
SHADOW_ADJACENCY_MAX_DISTANCE_PX=8

# GLCM Texture Configuration
GLCM_NUM_LEVELS=16
GLCM_MIN_VALID_PIXELS=16

# Context Background Configuration
CONTEXT_DILATION_RADIUS_PX=25
CONTEXT_MIN_BACKGROUND_PIXELS=32

# Storage Folders
UPLOAD_DIR=storage/uploads
DEBUG_OUTPUT_DIR=storage/debug_outputs
REPORT_OUTPUT_DIR=storage/reports

# Database Configuration
# Default PostgreSQL URL (used when USE_SQLITE_TEST=False)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/ghostnet_db
# Local SQLite Database for development / offline use
SQLITE_TEST_DB=sqlite:///./ghostnet_dev.db
USE_SQLITE_TEST=True
